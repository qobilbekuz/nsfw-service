# --- Umumiy ---
DEBUG=false
ROOT_PATH=/nsfw

# --- Auth ---
# false => X-API-Key majburiy (tavsiya etiladi)
PUBLIC_MODE=false
TRUSTED_IPS=127.0.0.1,::1
RATE_LIMIT_PER_MINUTE=60

# --- Redis (kesh + kalitlar + rate-limit) ---
REDIS_URL=redis://127.0.0.1:6379/4
CACHE_ENABLED=true
CACHE_TTL_SECONDS=604800

# --- Limitlar ---
MAX_IMAGE_BYTES=20971520
MAX_IMAGE_PIXELS=50000000
MAX_BATCH_ITEMS=20
BATCH_CONCURRENCY=8

# --- path rejimi: vergul bilan ajratilgan absolyut kataloglar ---
# Bo'sh qoldirilsa path rejimi butunlay o'chiq bo'ladi.
ALLOWED_PATH_ROOTS=

# --- Skorlash chegaralari (foizda) ---
# DIQQAT: bu qiymatlar o'lchanmagan, qo'lda tanlangan. O'z to'plamingizda
# kalibrlash uchun: training/README.md -> calibrate.py
THRESHOLD_NSFW=60
THRESHOLD_NSFL=50
THRESHOLD_SUGGESTIVE=25
THRESHOLD_NSFW_CONFIDENT=90

# --- O'z o'qitilgan boshingiz (ixtiyoriy) ---
# training/train_head.py yaratgan fayl nomi, models/ ichida.
# Bo'sh = asl model boshi. Yuklanmasa asl boshga qaytadi (servis tushmaydi).
CUSTOM_HEAD_FILE=

# --- onnxruntime ---
ONNX_INTRA_THREADS=2
ONNX_INTER_THREADS=1
